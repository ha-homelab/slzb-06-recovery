{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**",
    "requirements-core.in",
    "requirements-core.txt"
  ],
  "packageRules": [
    {
      "description": "Regenerate compiled locks with their recorded source command; avoid independent edits to inputs or output snapshots.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-core.in",
        "requirements-core.txt",
        "requirements-ha.in",
        "requirements-ha.txt",
        "requirements-radio.in",
        "requirements-radio.txt"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      ".github/cosign/**",
      "requirements-core.in",
      "requirements-core.txt",
      "requirements-ha.in",
      "requirements-ha.txt",
      "requirements-radio.in",
      "requirements-radio.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\-ha\\.txt$/",
      "/^requirements\\-radio\\.txt$/"
    ]
  },
  "description": [
    "Source-build dependency inputs and their generated locks are maintained together through the documented reviewed environment. Other native and CI updates remain automated."
  ]
}
