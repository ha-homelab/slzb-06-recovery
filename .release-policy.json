{
  "schema": 1,
  "repository": "ha-homelab/slzb-06-recovery",
  "visibility": "public",
  "mode": "release",
  "default_branch": "main",
  "version_file": "SOURCE_VERSION",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "python3 -m unittest discover -s tests -v"
  ],
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "container_assets": {},
  "notes": [
    "Release artifacts contain only the reviewed host recovery tools, tests and documentation. They contain no firmware, real backups, Zigbee network keys or operator configuration.",
    "All acceptance checks use synthetic data and dry-run CLI paths. Hardware identity, firmware acceptance and physical recovery remain separate operator responsibilities.",
    "The configured release-note file remains a full-validation input so its current release section, upgrade notes and security notes are checked."
  ],
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "toolkit_revision": "8c0743a8db82adb291eee77cbe4d9bfd07218ee3",
    "files": [
      {
        "path": "SOURCE_VERSION",
        "format": "text",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "slzb-06-recovery-*.tar.gz",
        "format": "tar-text",
        "member": "slzb-06-recovery/SOURCE_VERSION",
        "value": "package"
      }
    ],
    "required_build_receipts": [
      "release-inputs-package.json"
    ]
  },
  "fuzzing": {
    "toolkit_ref": "d4b21d156067ce58f89f89149bfad545e1889ae7"
  },
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "ROADMAP.md"
    ],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": [
      "codeql.yml"
    ]
  }
}
