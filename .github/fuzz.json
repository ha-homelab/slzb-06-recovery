{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "backup",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_backup.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/backup",
      "instrumentation": [
        {
          "module": "radio_legacy",
          "functions": [
            "find_network_backup"
          ]
        },
        {
          "module": "compare_network",
          "functions": [
            "compare"
          ]
        }
      ]
    },
    {
      "name": "identity",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_identity.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/identity",
      "instrumentation": [
        {
          "module": "esp32_core",
          "functions": [
            "normalize_mac",
            "validate_port"
          ]
        },
        {
          "module": "slzb",
          "functions": [
            "validate_base_url",
            "validate_identity"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    "fuzz",
    "requirements-core.txt",
    "requirements-ha.txt",
    "requirements-radio.txt",
    "scripts"
  ]
}
